# =============================================================================
# Indian Constitution AI - environment configuration
# Copy to backend/.env and fill in values. Never commit backend/.env.
# =============================================================================

# --- Application ---
APP_NAME="Indian Constitution AI"
APP_ENV=development                 # development | production | test
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-this-to-a-long-random-string     # signs browser session tokens
ADMIN_API_TOKEN=                    # required for /api/health/llm, /api/admin/* (X-Admin-Token header)
LOG_LEVEL=INFO
LOG_FORMAT=json                     # json | text
STORE_QUERY_TEXT=false              # keep raw questions in admin debug traces (default: hash only)

# --- Database ---
# SQLite (default). Relative paths are resolved from the backend directory.
DATABASE_URL=sqlite:///./data/app.db
# PostgreSQL (install a driver, e.g. psycopg[binary]); take a pg_dump before migrating:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/constitution_ai
DATA_DIR=./data
BACKUP_DIR=                         # default: DATA_DIR/backups

# --- LLM: Google Gemini (official google-genai SDK) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=                     # server-side only; never sent to the browser
GEMINI_MODEL=gemini-3.6-flash       # verified against ai.google.dev model list (2026-10-30)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite   # comma separated, tried on timeout / 5xx / unknown model
GEMINI_CLASSIFIER_MODEL=            # optional cheaper model for scenario classification
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768     # 768, 1536 or 3072
GEMINI_TIMEOUT=45                   # seconds per attempt
GEMINI_MAX_RETRIES=2                # retries per model for retryable errors (429/5xx/network)
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=3072
GEMINI_THINKING_LEVEL=low           # Gemini 3+ thinking level; empty to disable
QUERY_CLASSIFIER=hybrid             # rules | hybrid (rules + validated Gemini classification)

# --- Embeddings / vector retrieval ---
ENABLE_EMBEDDINGS=true
EMBEDDING_BATCH_SIZE=50
EMBEDDING_TEXTS_PER_MINUTE=90       # client-side pacing for free-tier quotas; 0 = unlimited

# --- Hybrid retrieval weights (weighted reciprocal rank fusion) ---
RETRIEVAL_TOP_K=12
RETRIEVAL_WEIGHT_EXACT=3.0
RETRIEVAL_WEIGHT_GRAPH=1.6
RETRIEVAL_WEIGHT_BM25=1.0
RETRIEVAL_WEIGHT_VECTOR=1.0
RETRIEVAL_RRF_K=60

# --- Knowledge sources ---
ENABLE_DEFAULT_KNOWLEDGE=true
ENABLE_USER_DOCUMENTS=true
ENABLE_KNOWLEDGE_GRAPH=true

# --- Neo4j (optional projection of the knowledge graph) ---
ENABLE_NEO4J=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- File upload / OCR ---
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./data/uploads
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,tiff,bmp
TESSERACT_CMD=tesseract

# --- CORS / rate limiting ---
CORS_ORIGINS=http://localhost:8000
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60
